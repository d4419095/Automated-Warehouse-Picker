# Ignore Python cache files
__pycache__/
*.py[cod]
*$py.class

# Ignore virtual environment
.venv
venv/
ENV/
env/
env.bak/
venv.bak/

# Ignore IDE and editor files
.idea/
.vscode/
*.swp
*.swo

# Ignore build artifacts
build/
dist/
*.egg-info/
*.egg

# Ignore test reports
htmlcov/
.coverage
.pytest_cache/

# Ignore sensitive files
*.env
*.log
secrets/
credentials.json
config.yaml

# Ignore OS-specific files
.DS_Store
Thumbs.db
